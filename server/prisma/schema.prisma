generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id          String   @id
  title       String
  description String?
  priority    String   @default("medium")
  assignee    String?
  status      String
  position    Int
  updatedAt   DateTime @default(now()) @updatedAt
}
